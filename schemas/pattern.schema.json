{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productdecisionos.org/schemas/pattern.schema.json",
  "title": "Pattern",
  "description": "Frontmatter carries only the supporting and contradicting evidence graph. Interpretation, frequency, recency, and coverage gaps live in the readable Markdown sections the validator requires.",
  "allOf": [
    { "$ref": "https://productdecisionos.org/schemas/common.schema.json" },
    {
      "type": "object",
      "required": ["supporting_signal_ids", "contradictory_signal_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^pattern_[0-9A-HJKMNP-TV-Z]{8,32}$" },
        "type": { "const": "pattern" },
        "supporting_signal_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^signal_[0-9A-HJKMNP-TV-Z]{8,32}$" }
        },
        "contradictory_signal_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^signal_[0-9A-HJKMNP-TV-Z]{8,32}$" }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
