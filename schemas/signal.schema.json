{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productdecisionos.org/schemas/signal.schema.json",
  "title": "Signal",
  "allOf": [
    { "$ref": "https://productdecisionos.org/schemas/common.schema.json" },
    {
      "type": "object",
      "required": ["summary", "sources", "segments", "interpretation_confidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^signal_[0-9A-HJKMNP-TV-Z]{8,32}$" },
        "type": { "const": "signal" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/sourceReference" }
        },
        "segments": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/stringList" },
        "account_reference": { "type": "string", "minLength": 1 },
        "revenue_band": { "enum": ["unknown", "low", "medium", "high", "strategic"] },
        "business_weight": { "type": "string", "minLength": 1 },
        "interpretation_confidence": { "enum": ["low", "medium", "high"] },
        "excerpt": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/excerpt" }
      }
    }
  ],
  "unevaluatedProperties": false
}
