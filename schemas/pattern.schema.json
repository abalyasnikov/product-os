{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productdecisionos.org/schemas/pattern.schema.json",
  "title": "Pattern",
  "allOf": [
    { "$ref": "https://productdecisionos.org/schemas/common.schema.json" },
    {
      "type": "object",
      "required": ["interpretation", "supporting_signal_ids", "contradictory_signal_ids", "affected_segments", "frequency_summary", "recency_summary", "coverage_gaps"],
      "properties": {
        "id": { "type": "string", "pattern": "^pattern_[0-9A-HJKMNP-TV-Z]{8,32}$" },
        "type": { "const": "pattern" },
        "interpretation": { "type": "string", "minLength": 1 },
        "supporting_signal_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^signal_[0-9A-HJKMNP-TV-Z]{8,32}$" }
        },
        "contradictory_signal_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^signal_[0-9A-HJKMNP-TV-Z]{8,32}$" }
        },
        "affected_segments": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/stringList" },
        "frequency_summary": { "type": "string", "minLength": 1 },
        "business_weight_summary": { "type": "string", "minLength": 1 },
        "recency_summary": { "type": "string", "minLength": 1 },
        "coverage_gaps": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/stringList" }
      }
    }
  ],
  "unevaluatedProperties": false
}
