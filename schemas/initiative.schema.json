{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productdecisionos.org/schemas/initiative.schema.json",
  "title": "Initiative",
  "allOf": [
    { "$ref": "https://productdecisionos.org/schemas/common.schema.json" },
    {
      "type": "object",
      "required": ["opportunity_id", "target_outcome", "product_thesis", "evidence_ids", "business_impact", "gtm_hypothesis", "outcome", "barriers", "child_prd_ids", "dependencies", "learnings"],
      "properties": {
        "id": { "type": "string", "pattern": "^initiative_[0-9A-HJKMNP-TV-Z]{8,32}$" },
        "type": { "const": "initiative" },
        "opportunity_id": { "type": "string", "pattern": "^opportunity_[0-9A-HJKMNP-TV-Z]{8,32}$" },
        "target_outcome": { "type": "string", "minLength": 1 },
        "product_thesis": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(signal|pattern|opportunity)_[0-9A-HJKMNP-TV-Z]{8,32}$" }
        },
        "business_impact": { "type": "string", "minLength": 1 },
        "gtm_hypothesis": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/gtmHypothesis" },
        "outcome": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/outcomeContract" },
        "barriers": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/stringList" },
        "child_prd_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^prd_[0-9A-HJKMNP-TV-Z]{8,32}$" }
        },
        "dependencies": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/stringList" },
        "sequencing": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/stringList" },
        "learnings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^learning_[0-9A-HJKMNP-TV-Z]{8,32}$" }
        },
        "implementation_refs": {
          "type": "array",
          "items": { "$ref": "https://productdecisionos.org/schemas/common.schema.json#/$defs/implementationReference" }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
